{
  "name": "tradeos-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "gen:api": "bash -o pipefail -c 'python3 scripts/export_openapi.py | openapi-typescript -o src/api/api.d.ts' && npm run gen:platform-api",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "gen:platform-api": "bash -o pipefail -c 'python3 scripts/export_platform_openapi.py | openapi-typescript -o src/api/platform-api.d.ts'"
  },
  "dependencies": {
    "ant-design-vue": "4.2.6",
    "openapi-fetch": "0.17.0",
    "vue": "3.5.43",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "happy-dom": "20.11.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.9"
  }
}
