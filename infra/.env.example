# TradeOS 环境变量清单（Phase 1）
# 复制到仓库根 .env 后填值；填好的 .env 永不提交。
# 变量名与生产保持一致——避免"本地能跑、线上找不到 key"。

# --- 基础 ---
TRADEOS_ENV=                    # local | production
TRADEOS_TENANT_ID=              # Phase 1 单租户的固定租户 ID（ADR 0001）
TRADEOS_DEV_MODE=<true-required-for-phase1>
TRADEOS_CORS_ALLOWED_ORIGINS=<json-array-of-exact-http-or-https-origins>
TRADEOS_API_RETRY_AFTER_SECONDS=<positive-integer>
TRADEOS_HANDOFF_POLICY=<json-object-with-sla_seconds-backlog_threshold-t1_seconds-t2_seconds>
TRADEOS_SCORING_POLICY=<json-object-with-version-currency-decimal-string-boundaries-and-1-to-7-bucket-map>
TRADEOS_OUTBOX_MAX_ATTEMPTS=<positive-integer>
GMAIL_OAUTH_TOKEN_REF=<secret-reference>
TOOL_CALL_FINGERPRINT_KEY_REF=<secret-reference>
TOOL_CALL_FINGERPRINT_KEY_VERSION=<public-key-version>
TRADEOS_UNSUBSCRIBE_BASE_URL=<canonical-https-origin>
TRADEOS_EMAIL_FEEDBACK_ROUTE_ID=<public-lowercase-route-id>
TRADEOS_UNSUBSCRIBE_ACTIVE_KEY_ID=<active-public-key-id>
TRADEOS_UNSUBSCRIBE_KEY_REFS_JSON=<json-map-of-public-key-id-to-environment-variable-name>
# 上一行引用的环境变量（示例名称，值至少 32 bytes；不要提交真实值）
UNSUBSCRIBE_HMAC_CURRENT=<secret-value>
TRADEOS_TOOL_LEASE_SECONDS=<positive-integer>

# --- 可选报价运行组（API与scheduler共用纯JSON契约；缺整个变量保留旧模式）---
# TRADEOS_QUOTATION_SETTINGS_JSON 仅非秘密配置；显式提供时core/evidence/files三个键均必填。
# core: lock_timeout_ms, statement_timeout_ms, maximum_page_size, expiry_batch_limit。
# evidence: raw_maximum_bytes, object_read, parser, probe；嵌套字段沿infra/quote_evidence_settings.py。
# files: 可显式null禁用全部文件/客户版本能力，否则必须提供template_version、maximum_bytes、
# maximum_pages、maximum_text_bytes、object_read、object_write、rate_limit、gateway_lease_seconds。
# object_read/object_write/rate_limit均为严格完整预算对象，字段见infra/quotation_settings.py所引用契约。
# 所有预算需由部署方显式确认，无示例业务数字/默认单位/汇率/利润率；未知键或畸形配置启动失败。
# 还需原对象存储引用配置；构造不解析S3秘密。真实Linux parser经本进程受信probe，降级不伪造ready。
# expiry仅由取得原singleton的scheduler执行，API无后台扫描；来源/文件能力不授权发送。

# --- 邮件反馈 worker（bootstrap 固定 30 天，不提供覆盖变量）---
TRADEOS_EMAIL_FEEDBACK_GMAIL_BASE_URL=https://gmail.googleapis.com
# 仅本地验收：TRADEOS_DEV_MODE=true 时可改为 http://127.0.0.1:<port>
TRADEOS_EMAIL_FEEDBACK_MAILBOX_ALIAS=<public-lowercase-mailbox-alias>
TRADEOS_EMAIL_FEEDBACK_SENDING_IDENTITY_ID=<sid-ulid>
TRADEOS_EMAIL_FEEDBACK_ENABLED=<true-or-false>
TRADEOS_EMAIL_FEEDBACK_HEALTH_PORT=<integer-1-to-65535>
TRADEOS_EMAIL_FEEDBACK_POLL_INTERVAL_SECONDS=<integer-5-to-3600>
TRADEOS_EMAIL_FEEDBACK_PAGE_LIMIT=<integer-1-to-100>

# --- 通知 worker（员工地址目录只注入本进程，不进入 API/OpenAPI）---
TRADEOS_NOTIFICATION_GMAIL_BASE_URL=https://gmail.googleapis.com
# 仅本地验收：TRADEOS_DEV_MODE=true 时可改为 http://127.0.0.1:<port>
TRADEOS_NOTIFICATION_SENDING_IDENTITY_ID=<transactional-sid-ulid>
TRADEOS_NOTIFICATION_RECIPIENTS_JSON=<bounded-json-array-of-tenant-employee-address-mappings>
TRADEOS_NOTIFICATION_POLL_INTERVAL_SECONDS=<integer-1-to-3600>
TRADEOS_NOTIFICATION_BATCH_LIMIT=<integer-1-to-100>
TRADEOS_NOTIFICATION_HEALTH_PORT=<integer-1-to-65535>
TRADEOS_NOTIFICATION_LEASE_OWNER=<public-lowercase-worker-id>

# --- 数据库与存储 ---
DATABASE_URL=<sqlalchemy-async-postgresql-url>
REDIS_URL=                      # redis://localhost:6379/0
S3_ENDPOINT=REQUIRED_CANONICAL_HTTPS_ENDPOINT
S3_BUCKET_ARTIFACTS=REQUIRED_ARTIFACT_BUCKET
S3_ACCESS_KEY_REF=REQUIRED_S3_ACCESS_KEY_ENV_NAME
S3_SECRET_KEY_REF=REQUIRED_S3_SECRET_KEY_ENV_NAME
S3_REGION=REQUIRED_AWS_REGION
RAW_ARTIFACT_MAX_BYTES=REQUIRED_POSITIVE_INTEGER
GENERATED_ARTIFACT_MAX_BYTES=REQUIRED_POSITIVE_INTEGER

# --- 模型 ---
OPENAI_API_KEY=                 # 模型调用（经统一封装计量）
OPENAI_API_KEY_REF=OPENAI_API_KEY
TRADEOS_TRADE_MANAGER_MODEL=gpt-5-mini
AGENT_MODEL_DEFAULT=            # 默认模型标识（CapabilityAgent 参数）

# --- 连接器密钥引用（名称与 connectors/*/manifest 的 secret_refs 一致）---
GMAIL_OAUTH_TOKEN_REF=          # Gmail OAuth（授权流程在应用内完成）
EMAIL_VERIFY_API_KEY_REF=       # 可达性验证服务
CONTACT_ENRICH_API_KEY_REF=     # 联系人补全
WEB_SEARCH_API_KEY_REF=         # 公开搜索
TAVILY_API_KEY_REF=             # 仅填持有Tavily key的环境变量名；不填key本身
TRADEOS_TAVILY_EXCLUSIVE_ACCOUNT_CONFIRMED=false
# 仅经人工确认此免费账户不被其他部署/程序共享后设为true；引用轮换不重置额度。
# API仅展示configured_unverified，不启用scheduler。来源验收入口见HANDBOOK第九节。
# 默认 scripts/accept_research_discovery.py 返回not_run；真实运行需逐次CLI opt-in及预算确认。
FX_API_KEY_REF=                 # 汇率（免费源可留空）

# --- Hunter 联系人补全/验证部署元数据（仅声明，不读取 key）---
# 必须显式小写 true 或 false。false 时以下三个变量必须为空或不设置。
TRADEOS_HUNTER_CONTACTS_ENABLED=<true-or-false>
# true 时两个版本是安全显示元数据；引用名不是 key 值，但仍不得外显。
TRADEOS_HUNTER_CONFIGURATION_VERSION=<public-lowercase-deployment-version>
TRADEOS_HUNTER_API_KEY_SECRET_REF=<environment-variable-name-containing-key>
TRADEOS_HUNTER_API_KEY_VERSION=<public-lowercase-key-version>

# --- 发件（冷开发独立域名，见 ADR 0004）---
COLD_OUTREACH_DOMAIN=           # 冷开发域名（永不用主业务域名）
TRANSACTIONAL_SENDER=           # 系统通知发件地址

# --- 进程 ---
API_HOST=<api-bind-host>
API_PORT=<api-bind-port>
TRADEOS_SCHEDULER_INTERVAL_SECONDS=<positive-integer>
TRADEOS_SCHEDULER_BATCH_LIMIT=<positive-integer>
TRADEOS_SCHEDULER_LOCK_KEY=<signed-int64>
TRADEOS_SCHEDULER_OUTBOX_MAX_ATTEMPTS=<positive-integer>
TRADEOS_HANDOFF_T1_SECONDS=<positive-integer>
TRADEOS_HANDOFF_T2_SECONDS=<positive-integer>
TRADEOS_DKIM_SELECTOR=<public-lowercase-selector>
TRADEOS_SCHEDULER_HEALTH_PORT=<integer-1-to-65535>
# Campaign 序列自动发送（scheduler 装配 campaign_messaging 时使用；见
# SchedulerDomainDependencies。退订/路由/凭证引用与 API 一致）
TRADEOS_CAMPAIGN_RETRY_INTERVAL_SECONDS=<integer-1-to-86400>
SCHEDULER_INTERVAL_SECONDS=<legacy-non-runnable-placeholder>
AGENT_WORKER_CONCURRENCY=<positive-worker-concurrency>

# --- Slice 4 演示（scripts/demo_slice4_manual_send.py，受控模式）---
# 仅容器验收使用；生产不设置。复制本文件不会启用演示——运行演示时在命令行
# 显式设置：DATABASE_URL=<url> TRADEOS_SLICE4_DEMO_MODE=controlled \
#   python scripts/demo_slice4_manual_send.py
# TRADEOS_SLICE4_DEMO_MODE=<controlled-only-when-running-the-demo>
# 可选：覆盖 Gmail 凭证引用名（其环境变量值至少 16 bytes；缺失/过短 → 固定失败）
# TRADEOS_SLICE4_GMAIL_REF=<environment-variable-name>
# 可选：覆盖 fake DNS 端口（指向不可达端口 → 认证 workflow 失败 → 固定失败）
# TRADEOS_SLICE4_DNS_PORT=<integer-1-to-65535>

# --- 可观测性 ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
