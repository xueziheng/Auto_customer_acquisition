# TradeOS 环境变量清单（Phase 1）
# 复制到仓库根 .env 后填值；填好的 .env 永不提交。
# 变量名与生产保持一致——避免"本地能跑、线上找不到 key"。

# --- 基础 ---
TRADEOS_ENV=                    # local | production
TRADEOS_TENANT_ID=              # Phase 1 单租户的固定租户 ID（ADR 0001）
TRADEOS_DEV_MODE=<true-required-for-phase1>
TRADEOS_CORS_ALLOWED_ORIGINS=<json-array-of-exact-http-or-https-origins>
TRADEOS_API_RETRY_AFTER_SECONDS=<positive-integer>
TRADEOS_HANDOFF_POLICY=<json-object-with-sla_seconds-backlog_threshold-t1_seconds-t2_seconds>
TRADEOS_SCORING_POLICY=<json-object-with-version-currency-decimal-string-boundaries-and-1-to-7-bucket-map>
TRADEOS_OUTBOX_MAX_ATTEMPTS=<positive-integer>
GMAIL_OAUTH_TOKEN_REF=<secret-reference>
TOOL_CALL_FINGERPRINT_KEY_REF=<secret-reference>
TOOL_CALL_FINGERPRINT_KEY_VERSION=<public-key-version>
TRADEOS_UNSUBSCRIBE_BASE_URL=<canonical-https-origin>
TRADEOS_TOOL_LEASE_SECONDS=<positive-integer>

# --- 数据库与存储 ---
DATABASE_URL=<sqlalchemy-async-postgresql-url>
REDIS_URL=                      # redis://localhost:6379/0
S3_ENDPOINT=                    # http://localhost:9000（MinIO）
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_ARTIFACTS=            # 原始资料桶

# --- 模型 ---
OPENAI_API_KEY=                 # 模型调用（经统一封装计量）
AGENT_MODEL_DEFAULT=            # 默认模型标识（CapabilityAgent 参数）

# --- 连接器密钥引用（名称与 connectors/*/manifest 的 secret_refs 一致）---
GMAIL_OAUTH_TOKEN_REF=          # Gmail OAuth（授权流程在应用内完成）
EMAIL_VERIFY_API_KEY_REF=       # 可达性验证服务
CONTACT_ENRICH_API_KEY_REF=     # 联系人补全
WEB_SEARCH_API_KEY_REF=         # 公开搜索
FX_API_KEY_REF=                 # 汇率（免费源可留空）

# --- 发件（冷开发独立域名，见 ADR 0004）---
COLD_OUTREACH_DOMAIN=           # 冷开发域名（永不用主业务域名）
TRANSACTIONAL_SENDER=           # 系统通知发件地址

# --- 进程 ---
API_HOST=<api-bind-host>
API_PORT=<api-bind-port>
SCHEDULER_INTERVAL_SECONDS=<positive-scheduler-interval-seconds>
AGENT_WORKER_CONCURRENCY=<positive-worker-concurrency>

# --- 可观测性 ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
